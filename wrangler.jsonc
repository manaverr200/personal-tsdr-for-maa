{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-tsdr-for-maa",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": false }
}
